# Copy this file to .env and edit it before starting the server.
# Do not commit or share .env: it contains the server password.

NAME=Valheim Dedicated Server
PORT=2456
WORLD=DedicatedWorld
# Set a strong password. PASSWORD_FILE is also supported when a Compose
# override mounts a secret file into the container.
PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Do not rename this to PUBLIC. Windows already defines PUBLIC as a path.
SERVER_PUBLIC=0
CROSSPLAY=true

# Difficulty and world modifiers. Leave empty for normal settings.
# A preset can be combined with modifiers; modifiers must come after the preset.
# Examples:
# SERVER_ARGS=-preset hard
# SERVER_ARGS=-preset hard -modifier raids none -modifier resources more
# SERVER_ARGS=-modifier combat hard -modifier deathpenalty casual -setkey nomap
SERVER_ARGS=

# Platform ID(s) of administrators. Separate several IDs with spaces or commas.
# The ID format is shown in the server log, for example Steam_<steam64_id>.
ADMINLIST_IDS=
# Optional: BANNEDLIST_IDS=Steam_<steam64_id>
# Optional: PERMITTEDLIST_IDS=Steam_<steam64_id> Steam_<steam64_id>
TZ=UTC

# Optional. Set to `id -u` and `id -g` for the Linux account that owns
# /srv/valheim; leave at zero to use the upstream image's root default.
PUID=0
PGID=0

# Valheim saves the world every 15 minutes by default in this bundle.
# The value is seconds; 1800 means 30 minutes, 600 means 10 minutes.
SAVEINTERVAL=900

# Valheim's own emergency copies kept beside the world.
BACKUPS=4
BACKUPSHORT=7200
BACKUPLONG=43200

# Rolling archives created by the Valheim image, written to ./backups/valheim.
# BACKUPS_CRON overrides BACKUPS_INTERVAL when it is non-empty.
BACKUPS_INTERVAL=3600
BACKUPS_MAX_AGE=14
BACKUPS_MAX_COUNT=168
BACKUPS_ZIP=true
# BACKUPS_CRON="5 * * * *"

# Retention for archives explicitly created with scripts/backup.sh.
# These are stored in ./backups/manual and pruned on the next manual backup.
MANUAL_BACKUP_RETENTION_DAYS=30

# Steam/Valheim update checks. Keep disabled on this Pi setup and update manually.
UPDATE_INTERVAL=0
UPDATE_IF_IDLE=true
UPDATE_IDLE_CHECKS=5
UPDATE_IDLE_CHECK_INTERVAL=60
IDLE_DATAGRAM_WINDOW=3
IDLE_DATAGRAM_MAX_COUNT=30
SERVER_STOP_TIMEOUT=150

# Disabled by default. Example: RESTART_CRON="10 5 * * *"
RESTART_CRON=
RESTART_IF_IDLE=true
