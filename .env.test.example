# Copy to .env.test for the isolated mod test server. Do not commit .env.test.
ARM64_DEVICE=generic
TEST_NAME=Valheim Mod Test
TEST_PORT=2458
TEST_WORLD=ModTestWorld
TEST_PASSWORD=CHANGE_ME_TEST_PASSWORD
TEST_SERVER_PUBLIC=0
# Keep false while verifying that BepInEx itself loads. Set true only after
# testing a mod that its author explicitly states supports Crossplay.
TEST_CROSSPLAY=false
TEST_MODS_ENABLED=true
